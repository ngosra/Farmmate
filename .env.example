# Copy to .env for local development. Do not commit .env or production secrets.

DJANGO_SECRET_KEY=dev-only-not-a-secret-key-32-bytes-min
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use SQLite. With Docker Compose, uncomment the PostGIS URL.
# DATABASE_URL=postgis://farmmate:local-dev-only@localhost:5432/farmmate

REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=local-dev-only
MINIO_SECRET_KEY=local-dev-only-change-me
POSTGRES_PASSWORD=local-dev-only

# Used only by: python manage.py bootstrap_dev
# FARMMATE_BOOTSTRAP_EMAIL=admin@example.com
# FARMMATE_BOOTSTRAP_PASSWORD=
# FARMMATE_BOOTSTRAP_ORG=FarmMate

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
