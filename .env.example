# Copy to .env for local development. Do not commit .env or production secrets.

DJANGO_SECRET_KEY=dev-only-not-a-secret-key-32-bytes-min
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use SpatiaLite (GeoDjango on SQLite).
# With Docker Compose, uncomment the PostGIS URL.
# SPATIALITE_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/mod_spatialite.so
# DATABASE_URL=postgis://farmmate:local-dev-only@localhost:5432/farmmate

REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=local-dev-only
MINIO_SECRET_KEY=local-dev-only-change-me
POSTGRES_PASSWORD=local-dev-only

# Used only by: python manage.py seed_demo
# Creates Demo Cooperative, a sample farm, and an open checklist. Not a certificate.
# FARMMATE_DEMO_PASSWORD=

# Used only by: python manage.py bootstrap_dev
# FARMMATE_BOOTSTRAP_EMAIL=admin@example.com
# FARMMATE_BOOTSTRAP_PASSWORD=
# FARMMATE_BOOTSTRAP_ORG=FarmMate

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FarmMate <noreply@localhost>

# Optional. Leave empty to answer from recorded farm data without an external model.
# Setting a key sends grounded statements to that provider. It does not let the model invent records.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional satellite provider. "none" stores nothing and never fabricates NDVI.
SATELLITE_PROVIDER=none

# Optional public map token for the web app. The API does not need it.
# VITE_MAPBOX_TOKEN=
